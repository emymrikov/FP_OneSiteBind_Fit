

[General Information]
Function Name = FP_OneSiteBind
Brief Description = One-site binding with ligand depletion (Morrison equation). Fits a fluorescence anisotropy titration A(L): A = Amin - fB*(Amin-Amax), where fB = (Kd+P+L-sqrt((Kd+P+L)^2-4*P*L))/(2*P) is the bound fraction of the labeled probe P titrated with the binding partner L. Assumes 1:1 equilibrium binding; P must be fixed at the total probe concentration in the same units as L and Kd.
Function Source = N/A
Number Of Parameters = 4
Function Type = User-Defined
Function Form = Equations
Path = 
Number Of Independent Variables = 1
Number Of Dependent Variables = 1
Category = User Defined|EC50
FunctionPrev = NewFunction
Function Model = Explicit
Analytical Derivatives for User-Defined = 0


[Fitting Parameters]
Names = Amin,Amax,Kd,P
Initial Values = 50(V),300(V),1(V),0.05(F)
Meanings = Anisotropy of free probe,Anisotropy of fully bound probe,Dissociation constant,Total labeled probe concentration
Lower Bounds = 0(I, On),0(X, On),0(X, On),0(X, On)
Upper Bounds = --(I, Off),--(I, Off),--(I, Off),--(I, Off)
Naming Method = User-Defined
Number Of Significant Digits = 0,0,0,0
Unit = mAu,mAu,uM,uM
Format = --,--,--,--
CustomDisplay = --,--,--,--


[Independent Variables]
L = 


[Dependent Variables]
A = 


[Formula]
A=Amin-(((Kd+P+L)-((Kd+P+L)^2-4*P*L)^0.5)/2/P)*(Amin-Amax)


